# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# Generate passwords with: openssl rand -hex 24

# Postgres password for the `canvas` user. Only applied when the pgdata volume is
# first created; to change it later, ALTER USER in Postgres and update this value.
POSTGRES_PASSWORD=

# Canvas site admin, created once by db:initial_setup on first run.
CANVAS_ADMIN_EMAIL=
CANVAS_ADMIN_PASSWORD=

# Optional: host port for desktop DB tools (default 5432)
# DB_HOST_PORT=5432
