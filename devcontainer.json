{
  "name": "Canvas LMS",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  
  "postStartCommand": "echo 'starting container' > /workspace/starWithMe/started.txt",  
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "koichisasada.vscode-rdbg",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "Shopify.ruby-lsp",
        "eamodio.gitlens"
      ]
    }
  }
}