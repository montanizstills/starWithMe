{
  "name": "GitHub Codespaces (Default)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "runArgs": ["--privileged"],
  "remoteUser": "codespace",
  "overrideCommand": false
}